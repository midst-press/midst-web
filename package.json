{
  "name": "midst",
  "version": "0.0.1",
  "description": "Poetry in motion as envisaged by midst.press",
  "author": {
    "name": "Annelyse Gelman",
    "email": "annelysegelman@gmail.com",
    "url": "https://midst.press"
  },
  "scripts": {
    "build": "node tools/check-key-scheme.mjs && parcel build src/index.html --public-url / --no-autoinstall",
    "check:deps": "node tools/check-unused-deps.mjs",
    "coverage": "rm -rf coverage && jest --coverage --collectCoverageFrom='src/**/*.{ts,tsx,js,jsx}' --collectCoverageFrom=e2e/coverage-control.ts --coverageReporters=json --reporters=default --reporters=./scripts/coverage-jest-reporter.cjs && MIDST_COVERAGE=1 playwright test ${MIDST_COVERAGE_TEST_ARGS:-} && node scripts/coverage-merge.mjs",
    "e2e:build": "MIDST_APP_API_URL=https://api.example.invalid MIDST_APP_AUTH_DOMAIN=https://auth.example.invalid MIDST_APP_CLIENT_ID=zqclient MIDST_BUILD_TAG=v9.9.9-zq MIDST_BUILD_COMMIT=zq12345 MIDST_BUILD_DATE=2001-02-03T04:05:00Z MIDST_POEMS_URL=http://127.0.0.1:${MIDST_E2E_PORT:-8099}/archive/ MIDST_MEDIA_URL=http://127.0.0.1:${MIDST_E2E_PORT:-8099}/archive/ MIDST_FONTS_URL=http://127.0.0.1:${MIDST_E2E_PORT:-8099}/archive/fonts/ npm run build -- ${MIDST_COVERAGE:+--no-optimize} && parcel build e2e/legacy-harness.html --public-url / --no-autoinstall ${MIDST_COVERAGE:+--no-optimize}",
    "e2e:build:published": "MIDST_POEM_LIST=published MIDST_BUILD_TAG=v9.9.9-zq MIDST_BUILD_COMMIT=zq12345 MIDST_BUILD_DATE=2001-02-03T04:05:00Z MIDST_POEMS_URL=http://127.0.0.1:${MIDST_E2E_PUBLISHED_PORT:-8098}/archive/ MIDST_MEDIA_URL=http://127.0.0.1:${MIDST_E2E_PUBLISHED_PORT:-8098}/archive/ MIDST_FONTS_URL=http://127.0.0.1:${MIDST_E2E_PUBLISHED_PORT:-8098}/archive/fonts/ npm run build -- --dist-dir dist-published",
    "e2e:fixtures": "node tools/make-e2e-fixtures.mjs",
    "e2e:fixtures:published": "MIDST_POEM_LIST=published node tools/make-e2e-fixtures.mjs",
    "e2e:serve": "node tools/serve-local.mjs --root dist --archive e2e/fixtures/poems --port ${MIDST_E2E_PORT:-8099} --host 127.0.0.1 --prepare \"npm run e2e:fixtures && npm run e2e:build\"",
    "e2e:serve:published": "node tools/serve-local.mjs --root dist-published --archive e2e/fixtures/published --port ${MIDST_E2E_PUBLISHED_PORT:-8098} --host 127.0.0.1 --prepare \"npm run e2e:fixtures:published && npm run e2e:build:published\"",
    "start": "node tools/check-key-scheme.mjs && parcel src/index.html --no-autoinstall",
    "test:e2e": "playwright test",
    "test:e2e:published": "MIDST_POEM_LIST=published playwright test --config playwright.published.config.ts",
    "e2e:frame-budget": "playwright test --grep \"@frame-budget\"",
    "e2e:frame-budget:attest": "node tools/frame-budget-attest.mjs",
    "prepare": "node tools/install-hooks.cjs",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:coverage-control": "node --test scripts/coverage-control-check.test.mjs"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@rooks/use-window-size": "4.6.1",
    "@tiptap/pm": "2.5.4",
    "@tiptap/react": "2.5.4",
    "@tiptap/starter-kit": "2.5.4",
    "@types/jquery": "3.3.38",
    "@types/lodash": "4.14.153",
    "@types/marked": "1.1.0",
    "@types/node": "12.12.42",
    "@types/react": "16.9.53",
    "@types/react-dom": "16.8.4",
    "@types/react-helmet": "5.0.16",
    "@types/react-redux": "7.1.9",
    "@types/react-router-dom": "5.1.5",
    "@types/uuid": "3.4.9",
    "@types/voca": "1.4.0",
    "global.css": "1.1.0",
    "immer": "4.0.2",
    "insane": "2.6.2",
    "jquery": "3.5.1",
    "lodash": "4.17.11",
    "marked": "0.7.0",
    "moment": "2.26.0",
    "normalize.css": "8.0.1",
    "react": "18.0.0",
    "react-dom": "18.0.0",
    "react-helmet": "5.2.1",
    "react-redux": "7.1.3",
    "react-router": "6.3.0",
    "react-router-dom": "6.3.0",
    "react-scrollbars-custom": "4.0.25",
    "redux": "4.0.5",
    "redux-devtools-extension": "2.13.8",
    "redux-saga": "1.1.3",
    "redux-thunk": "2.3.0",
    "roman-numeral-to-decimal": "1.0.1",
    "scroll-into-view": "1.14.1",
    "slick-carousel": "1.8.1",
    "smoothscroll-polyfill": "0.4.4",
    "striptags": "3.1.1",
    "tone": "13.8.34",
    "uuid": "3.4.0",
    "voca": "1.4.0",
    "zip-js": "0.0.2"
  },
  "devDependencies": {
    "@babel/core": "7.10.0",
    "@playwright/test": "^1.64.0",
    "depcheck": "1.4.7",
    "istanbul-lib-coverage": "3.2.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "monocart-coverage-reports": "2.13.2",
    "parcel": "2.16.4",
    "parcel-reporter-static-files-copy": "1.5.3",
    "prettier": "1.18.2",
    "process": "^0.11.10",
    "ts-jest": "^29.4.14",
    "typescript": "4.6.3"
  },
  "overrides": {
    "@tiptap/core": "2.5.4",
    "@tiptap/pm": "2.5.4",
    "@tiptap/extension-blockquote": "2.5.4",
    "@tiptap/extension-bold": "2.5.4",
    "@tiptap/extension-bubble-menu": "2.5.4",
    "@tiptap/extension-bullet-list": "2.5.4",
    "@tiptap/extension-code": "2.5.4",
    "@tiptap/extension-code-block": "2.5.4",
    "@tiptap/extension-document": "2.5.4",
    "@tiptap/extension-dropcursor": "2.5.4",
    "@tiptap/extension-floating-menu": "2.5.4",
    "@tiptap/extension-gapcursor": "2.5.4",
    "@tiptap/extension-hard-break": "2.5.4",
    "@tiptap/extension-heading": "2.5.4",
    "@tiptap/extension-history": "2.5.4",
    "@tiptap/extension-horizontal-rule": "2.5.4",
    "@tiptap/extension-italic": "2.5.4",
    "@tiptap/extension-list-item": "2.5.4",
    "@tiptap/extension-ordered-list": "2.5.4",
    "@tiptap/extension-paragraph": "2.5.4",
    "@tiptap/extension-strike": "2.5.4",
    "@tiptap/extension-text": "2.5.4"
  },
  "resolutions": {
    "@babel/preset-env": "7.13.8"
  },
  "browserslist": [
    ">0.3%",
    "last 2 versions",
    "not dead"
  ],
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/tools/require-hooks.cjs",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.{ts,tsx}",
      "<rootDir>/tools/__tests__/**/*.test.cjs"
    ],
    "setupFiles": [
      "<rootDir>/src/__tests__/jest-key-scheme.setup.js"
    ],
    "transform": {
      "^.+\\.[tj]sx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "target": "es2019",
            "jsx": "react",
            "allowJs": true,
            "esModuleInterop": true,
            "resolveJsonModule": true,
            "isolatedModules": true
          }
        }
      ]
    },
    "coverageProvider": "v8",
    "coverageReporters": [
      "text",
      "json-summary",
      "json"
    ],
    "collectCoverageFrom": [
      "src/poems/poem-names.js",
      "src/poems/asset-fetch.js",
      "src/poems/poem-list.js",
      "src/poems/key-scheme.js",
      "src/poems/index.ts",
      "src/config.ts",
      "src/fonts.ts",
      "src/store/reducer.ts",
      "src/store/actions.ts",
      "src/store/midst-file.ts",
      "src/components/MidstPlayer/follow.ts",
      "src/components/MidstPlayer/helpers.ts",
      "src/components/MidstPlayer/timestamp-position.ts",
      "src/components/MidstPlayer/timeline.ts",
      "src/components/MidstPlayer/MidstPlayer.tsx",
      "src/app/auth.ts",
      "src/app/api.ts"
    ],
    "coverageThreshold": {
      "./src/poems/poem-names.js": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/poems/asset-fetch.js": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/poems/key-scheme.js": {
        "branches": 100,
        "functions": 100,
