{
  "name": "midst",
  "version": "0.0.1",
  "description": "Poetry in motion as envisaged by midst.press",
  "author": {
    "name": "Annelyse Gelman",
    "email": "annelysegelman@gmail.com",
    "url": "https://midst.press"
  },
  "scripts": {
    "build": "node tools/check-key-scheme.mjs && npm run catalog:compile && parcel build src/index.html --public-url / --no-autoinstall --no-cache",
    "catalog:compile": "lingui compile",
    "catalog:extract": "lingui extract",
    "catalog:check": "node tools/check-catalog.mjs",
    "catalog:report": "lingui extract && (test -z \"$(git status --porcelain -- locales)\" || echo 'catalog: lingui extract changed locales/, so the catalog does not match the code (report only)') && node tools/check-catalog.mjs --report-only && node tools/check-site-strings.mjs --report-only && node tools/check-lingui-pin.mjs",
    "check:deps": "node tools/check-unused-deps.mjs",
    "coverage": "rm -rf coverage && jest --coverage --collectCoverageFrom='src/**/*.{ts,tsx,js,jsx}' --collectCoverageFrom=e2e/coverage-control.ts --coverageReporters=json --reporters=default --reporters=./scripts/coverage-jest-reporter.cjs && MIDST_COVERAGE=1 tools/e2e-split.sh ${MIDST_COVERAGE_TEST_ARGS:-} && node scripts/coverage-merge.mjs",
    "e2e:build": "env MIDST_APP_API_URL=https://api.example.invalid MIDST_APP_AUTH_DOMAIN=https://auth.example.invalid MIDST_APP_CLIENT_ID=zqclient MIDST_BUILD_TAG=v9.9.9-zq MIDST_BUILD_COMMIT=zq12345 MIDST_BUILD_DATE=2001-02-03T04:05:00Z MIDST_POEMS_URL=http://127.0.0.1:${MIDST_E2E_PORT:-8099}/archive/ MIDST_MEDIA_URL=http://127.0.0.1:${MIDST_E2E_PORT:-8099}/archive/ MIDST_FONTS_URL=http://127.0.0.1:${MIDST_E2E_PORT:-8099}/archive/fonts/ sh -c 'npm run build -- ${MIDST_COVERAGE:+--no-optimize} && parcel build e2e/legacy-harness.html --public-url / --no-autoinstall --no-cache ${MIDST_COVERAGE:+--no-optimize}'",
    "e2e:build:published": "MIDST_POEM_LIST=published MIDST_BUILD_TAG=v9.9.9-zq MIDST_BUILD_COMMIT=zq12345 MIDST_BUILD_DATE=2001-02-03T04:05:00Z MIDST_POEMS_URL=http://127.0.0.1:${MIDST_E2E_PUBLISHED_PORT:-8098}/archive/ MIDST_MEDIA_URL=http://127.0.0.1:${MIDST_E2E_PUBLISHED_PORT:-8098}/archive/ MIDST_FONTS_URL=http://127.0.0.1:${MIDST_E2E_PUBLISHED_PORT:-8098}/archive/fonts/ npm run build -- --dist-dir dist-published",
    "e2e:fixtures": "node tools/make-e2e-fixtures.mjs",
    "e2e:fixtures:published": "MIDST_POEM_LIST=published node tools/make-e2e-fixtures.mjs",
    "e2e:serve": "node tools/serve-local.mjs --root dist --archive e2e/fixtures/poems --port ${MIDST_E2E_PORT:-8099} --host 127.0.0.1 --prepare \"npm run e2e:fixtures && npm run e2e:build\"",
    "e2e:serve:published": "node tools/serve-local.mjs --root dist-published --archive e2e/fixtures/published --port ${MIDST_E2E_PUBLISHED_PORT:-8098} --host 127.0.0.1 --prepare \"npm run e2e:fixtures:published && npm run e2e:build:published\"",
    "start": "node tools/check-key-scheme.mjs && npm run catalog:compile && parcel src/index.html --no-autoinstall",
    "test:e2e": "playwright test",
    "test:e2e:published": "MIDST_POEM_LIST=published playwright test --config playwright.published.config.ts",
    "e2e:frame-budget": "playwright test --grep \"@frame-budget|@gui\"",
    "e2e:frame-budget:attest": "node tools/frame-budget-attest.mjs",
    "prepare": "node tools/install-hooks.cjs",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:coverage-control": "node --test scripts/coverage-control-check.test.mjs scripts/coverage-has-code.test.mjs"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@lingui/core": ">=5.9.5 <6",
    "@midst-press/midst-format": "file:vendor/midst-format",
    "@rooks/use-window-size": "4.11.2",
    "@tiptap/core": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/jquery": "3.3.38",
    "@types/lodash": "4.17.26",
    "@types/marked": "1.1.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-helmet": "^6.1.11",
    "@types/react-redux": "^7.1.34",
    "@types/react-router-dom": "5.1.5",
    "@types/uuid": "3.4.9",
    "@types/voca": "1.4.6",
    "@zip.js/zip.js": "2.24.0",
    "global.css": "1.1.0",
    "immer": "4.0.2",
    "insane": "2.6.2",
    "jquery": "3.5.1",
    "lodash": "4.18.1",
    "marked": "0.7.0",
    "moment": "2.31.0",
    "normalize.css": "8.0.1",
    "react": "18.0.0",
    "react-dom": "18.0.0",
    "react-helmet": "^6.1.0",
    "react-redux": "^7.2.9",
    "react-router": "6.3.0",
    "react-router-dom": "6.3.0",
    "react-scrollbars-custom": "^4.1.1",
    "redux": "4.0.5",
    "redux-devtools-extension": "2.13.9",
    "redux-thunk": "2.3.0",
    "smoothscroll-polyfill": "0.4.4",
    "uuid": "3.4.0",
    "voca": "1.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@lingui/cli": ">=5.9.5 <6",
    "@lingui/format-po": ">=5.9.5 <6",
    "@messageformat/parser": "5.2.0",
    "@playwright/test": "^1.64.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.9.3",
    "depcheck": "1.4.7",
    "istanbul-lib-coverage": "3.2.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "monocart-coverage-reports": "2.13.2",
    "parcel": "2.16.4",
    "parcel-reporter-static-files-copy": "1.5.3",
    "pofile": "1.1.4",
    "prettier": "1.18.2",
    "process": "^0.11.10",
    "ts-jest": "^29.4.14",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-blockquote": "3.32.0",
    "@tiptap/extension-bold": "3.32.0",
    "@tiptap/extension-bubble-menu": "3.32.0",
    "@tiptap/extension-bullet-list": "3.32.0",
    "@tiptap/extension-code": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-dropcursor": "3.32.0",
    "@tiptap/extension-floating-menu": "3.32.0",
    "@tiptap/extension-gapcursor": "3.32.0",
    "@tiptap/extension-hard-break": "3.32.0",
    "@tiptap/extension-heading": "3.32.0",
    "@tiptap/extension-horizontal-rule": "3.32.0",
    "@tiptap/extension-italic": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-list-item": "3.32.0",
    "@tiptap/extension-list-keymap": "3.32.0",
    "@tiptap/extension-ordered-list": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-strike": "3.32.0",
    "@tiptap/extension-text": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/html": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0"
  },
  "resolutions": {
    "@babel/preset-env": "7.13.8"
  },
  "browserslist": [
    ">0.3%",
    "last 2 versions",
    "not dead"
  ],
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/tools/jest-global-setup.cjs",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.{ts,tsx}",
      "<rootDir>/tools/__tests__/**/*.test.cjs"
    ],
    "setupFiles": [
      "<rootDir>/src/__tests__/jest-key-scheme.setup.js",
      "<rootDir>/src/__tests__/jest-web-streams.setup.js"
    ],
    "transform": {
      "^.+\\.[tj]sx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "rootDir": ".",
            "target": "es2019",
            "jsx": "react",
            "allowJs": true,
            "esModuleInterop": true,
            "resolveJsonModule": true,
            "isolatedModules": true
          }
        }
      ]
    },
    "coverageProvider": "v8",
    "coverageReporters": [
      "text",
      "json-summary",
      "json"
    ],
    "collectCoverageFrom": [
      "src/poems/poem-names.js",
      "src/poems/asset-fetch.js",
      "src/poems/poem-list.js",
      "src/poems/key-scheme.js",
      "src/poems/index.ts",
      "src/config.ts",
      "src/fonts.ts",
      "src/store/reducer.ts",
      "src/store/actions.ts",
      "src/store/midst-file.ts",
      "src/components/MidstPlayer/timestamp-position.ts",
      "src/components/MidstPlayer/timeline.ts",
      "src/components/MidstPlayer/MidstPlayer.tsx",
      "src/app/auth.ts",
      "src/app/api.ts"
    ],
    "coverageThreshold": {
      "./src/poems/poem-names.js": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/poems/asset-fetch.js": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/poems/key-scheme.js": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/poems/index.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/config.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/fonts.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/store/reducer.ts": {
        "branches": 94,
        "functions": 100,
        "lines": 99,
        "statements": 99
      },
      "./src/store/actions.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/store/midst-file.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/poems/poem-list.js": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/components/MidstPlayer/timestamp-position.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/components/MidstPlayer/timeline.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/components/MidstPlayer/MidstPlayer.tsx": {
        "branches": 79,
        "functions": 94,
        "lines": 94,
        "statements": 94
      },
      "./src/app/auth.ts": {
        "branches": 97,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/app/api.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/vendor/"
    ],
    "coverageDirectory": "coverage/unit"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
