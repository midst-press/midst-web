{
  "name": "midst",
  "version": "0.0.1",
  "description": "Poetry in motion as envisaged by midst.press",
  "author": {
    "name": "Annelyse Gelman",
    "email": "annelysegelman@gmail.com",
    "url": "https://midst.press"
  },
  "scripts": {
    "build": "parcel build src/index.html --public-url / --no-autoinstall",
    "check:deps": "node tools/check-unused-deps.mjs",
    "e2e:build": "MIDST_POEMS_URL=http://127.0.0.1:${MIDST_E2E_PORT:-8099}/archive/ MIDST_MEDIA_URL=http://127.0.0.1:${MIDST_E2E_PORT:-8099}/archive/ npm run build && parcel build e2e/legacy-harness.html --public-url / --no-autoinstall",
    "e2e:fixtures": "node tools/make-e2e-fixtures.mjs",
    "e2e:serve": "npm run e2e:fixtures && npm run e2e:build && node tools/serve-local.mjs --root dist --archive e2e/fixtures/poems --port ${MIDST_E2E_PORT:-8099} --host 127.0.0.1",
    "start": "parcel src/index.html --no-autoinstall",
    "test:e2e": "playwright test",
    "e2e:frame-budget": "playwright test --grep \"@frame-budget\"",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "license": "all rights reserved",
  "dependencies": {
    "@fortawesome/fontawesome-free": "5.12.1",
    "@rooks/use-window-size": "4.6.1",
    "@tiptap/pm": "2.5.4",
