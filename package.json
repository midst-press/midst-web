    "@tiptap/extension-document": "2.5.4",
    "@tiptap/extension-dropcursor": "2.5.4",
    "@tiptap/extension-floating-menu": "2.5.4",
    "@tiptap/extension-gapcursor": "2.5.4",
    "@tiptap/extension-hard-break": "2.5.4",
    "@tiptap/extension-heading": "2.5.4",
    "@tiptap/extension-history": "2.5.4",
    "@tiptap/extension-horizontal-rule": "2.5.4",
    "@tiptap/extension-italic": "2.5.4",
    "@tiptap/extension-list-item": "2.5.4",
    "@tiptap/extension-ordered-list": "2.5.4",
    "@tiptap/extension-paragraph": "2.5.4",
    "@tiptap/extension-strike": "2.5.4",
    "@tiptap/extension-text": "2.5.4"
  },
  "resolutions": {
    "@babel/preset-env": "7.13.8"
  },
  "browserslist": [
    ">0.3%",
    "last 2 versions",
    "not dead"
  ],
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.[tj]sx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "target": "es2019",
            "jsx": "react",
            "allowJs": true,
            "esModuleInterop": true,
            "resolveJsonModule": true,
            "isolatedModules": true
          }
        }
      ]
    },
    "coverageProvider": "v8",
    "coverageReporters": [
      "text",
      "json-summary"
    ],
    "collectCoverageFrom": [
      "src/poems/poem-names.js",
      "src/poems/asset-fetch.js",
      "src/poems/index.ts",
      "src/config.ts",
      "src/store/reducer.ts",
      "src/store/actions.ts",
      "src/components/midst-player-hack/midst-file.ts"
    ],
    "coverageThreshold": {
      "./src/poems/poem-names.js": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/poems/asset-fetch.js": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/poems/index.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/config.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/store/reducer.ts": {
        "branches": 94,
        "functions": 100,
        "lines": 99,
        "statements": 99
      },
      "./src/store/actions.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/components/midst-player-hack/midst-file.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  }
}
