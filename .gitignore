# ---- added when this repository was seeded ----

# build + dependencies
node_modules/
dist/
dist-published/
build/
.parcel-cache/
.cache/
.npm-cache/
.editor-provenance/

# LOGS -- never commit. yarn-error.log in the fork point contained a
# contributor's home directory paths and full shell PATH.
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
report.*.json

# OS + editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# local environment -- never commit
.env
.env.*
!.env.example

# code-graph (its manifest bakes an absolute path, so a committed one misdirects
# incremental updates in every other clone)
code-graph.db
code-graph.db.wal
manifest.json

# poem data does not live in this repository -- see DATA.md
*.midst
static/static/assets/poems/

# Playwright
test-results/
playwright-report/
blob-report/
.playwright/

# e2e fixtures are GENERATED, never committed. Two reasons, and either alone would be enough:
#   1. they are .midst.zip files, which the forbid-poem-data hook refuses outright -- correctly. The
#      answer is not to carve an exception into that rule for files that merely LOOK like poem data.
#   2. the zip deflate output is not byte-reproducible across platforms, so a committed copy cannot be
#      checked against the generator.
# Generated by tools/make-e2e-fixtures.mjs, which runs before the tests.
e2e/fixtures/

# Coverage output (npm run coverage): raw V8 dumps hold the built JavaScript; reports are regenerated.
coverage/

# Font files are served beside the site, never committed (#55). This is where a local copy goes.
static/fonts/

# Compiled message catalogs: generated from locales/<lang>/messages.po by `npm run catalog:compile`
locales/*/messages.ts
