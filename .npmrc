# React 18 is installed while several packages declare peer support for React 15-17 only
# (react-custom-scrollbars@4.2.1, react-helmet@5, @types/react@16.9). That mismatch is REAL and is
# tracked work, not something this flag fixes -- it only stops npm refusing to resolve. Every
# installer, including the one Parcel invokes internally, must agree, which is why it is here
# rather than being passed on the command line in some places and not others.
legacy-peer-deps=true
